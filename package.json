{
  "name": "@simulant/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Better-Auth instance for the Simulant ecosystem. Self-hosted libsql, organization plugin, 4-role accessControl, cross-subdomain SSO.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./db": "./src/db.ts",
    "./permissions": "./src/permissions.ts"
  },
  "scripts": {
    "generate-schema": "better-auth generate --config ./src/auth.ts --output ./src/schema.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.14.0 <1",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.2"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "dotenv": "^17.4.2",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@libsql/client": "^0.14.0",
    "@types/nodemailer": "^8.0.0",
    "better-auth": "^1.6.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.6.0"
  }
}
